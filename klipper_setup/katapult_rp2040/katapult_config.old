# Katapult configuration for Raspberry Pi Pico / Pico W
# This is a minimal config for RP2040 USB bootloader

# Architecture
CONFIG_MACH_RPXXXX=y
CONFIG_BOARD_DIRECTORY="rp2040"
CONFIG_MCU="rp2040"
CONFIG_MACH_RP2040=y

# Clock and memory
CONFIG_CLOCK_FREQ=12000000
CONFIG_FLASH_SIZE=0x200000
CONFIG_FLASH_BOOT_ADDRESS=0x10000100
CONFIG_RAM_START=0x20000000
CONFIG_RAM_SIZE=0x42000
CONFIG_STACK_SIZE=512

# Flash configuration - Katapult starts at 0x100 (after stage2)
CONFIG_RPXXXX_FLASH_START_0100=y
CONFIG_FLASH_START=0x10000000

# Application will be at 0x10004000 (16KB offset for Katapult)
CONFIG_FLASH_APPLICATION_ADDRESS=0x10004000
CONFIG_LAUNCH_APP_ADDRESS=0x10004000

# Stage2 bootloader - W25Q080 is default for Pico/Pico W
CONFIG_RP2040_HAVE_STAGE2=y
CONFIG_RP2040_STAGE2_FILE="boot2_w25q080.S"
CONFIG_RP2040_STAGE2_CLKDIV=2

# Communication interface - USB
CONFIG_RPXXXX_USB=y
CONFIG_USBSERIAL=y
CONFIG_USB=y

# USB IDs
CONFIG_USB_VENDOR_ID=0x1d50
CONFIG_USB_DEVICE_ID=0x614e
CONFIG_USB_SERIAL_NUMBER_CHIPID=y
CONFIG_USB_SERIAL_NUMBER="12345"

# Bootloader entry options
CONFIG_ENABLE_DOUBLE_RESET=y
CONFIG_ENABLE_BUTTON=n
CONFIG_ENABLE_LED=n

# Block size
CONFIG_BLOCK_SIZE=64

# Required selections
CONFIG_RPXXXX_SELECT=y
CONFIG_HAVE_CHIPID=y
CONFIG_HAVE_GPIO=y
