# Copy this file to klipper_setup/image_build/secrets/build.env and edit.

IMG_NAME=klipperpi-idex
RELEASE=bookworm
TIMEZONE=Europe/Zurich
LOCALE=en_GB.UTF-8
HOSTNAME=klipperpi
USERNAME=pi
KEYMAP=us
WIFI_COUNTRY=CH
STAGE_LIST="stage0 stage1 stage2"

# Optional WiFi credentials are intentionally not kept here.
# Put them in either:
#   ~/.config/klipperpi-idex/wifi.env
# or:
#   klipper_setup/image_build/secrets/wifi.env
# with WIFI_SSID or WIFI_SSIDS plus WIFI_PASSWORD. The generated profiles are
# intentionally not bound to an interface; with onboard WiFi disabled, the USB
# WiFi dongle becomes wlan0.
# Example for multiple networks using the same password:
#   WIFI_SSIDS=("office-ssid" "basement-ssid")

# Pins (git shas or tags)
KLIPPER_COMMIT=master
MOONRAKER_COMMIT=master
MAINSAIL_VERSION=2.16.0
KLIPPERSCREEN_COMMIT=master
