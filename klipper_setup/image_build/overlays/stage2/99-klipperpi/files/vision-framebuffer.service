[Unit]
Description=High-resolution RAM-buffered webcam still-frame service
After=network-online.target menderpi-wlan-ready.service
Wants=network-online.target
Requires=menderpi-wlan-ready.service

[Service]
Type=simple
ExecStart=/usr/local/bin/vision_framebuffer.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
