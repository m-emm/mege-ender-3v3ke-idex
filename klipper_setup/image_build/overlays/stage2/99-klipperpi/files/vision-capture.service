[Unit]
Description=Vision-grade high-resolution webcam capture bridge
After=klipper.service moonraker.service vision-framebuffer.service
Wants=klipper.service vision-framebuffer.service

[Service]
Type=simple
Environment=VISION_REGISTER_NOZZLE_METHODS=0
ExecStart=/usr/local/bin/vision_capture.py --daemon
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
