[Unit]
Description=Nozzle camera capture and calibration-job bridge
After=klipper.service moonraker.service vision-framebuffer-nozzle-cam.service
Wants=klipper.service vision-framebuffer-nozzle-cam.service

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=video
RuntimeDirectory=vision-capture-nozzle_cam
RuntimeDirectoryMode=0755
Environment=VISION_CAMERA_DEVICE=/dev/v4l/by-id/usb-Vimicro_corp._PC-LM1E_Camera_PC-LM1E_Audio-video-index0
Environment=VISION_FRAMEBUFFER_DIR=/run/vision-preview-nozzle_cam
Environment=VISION_OUTPUT_DIR=/home/pi/printer_data/vision/manual_nozzle_cam
Environment=VISION_WEBCAM_SNAPSHOT_URL=http://127.0.0.1/nozzle_cam/?action=snapshot
Environment=VISION_PUBLIC_SNAPSHOT_URL=/nozzle_cam/?action=snapshot
Environment=VISION_OUTPUT_URL_PREFIX=/vision/manual_nozzle_cam
Environment=VISION_CAPTURE_REMOTE_METHOD=nozzle_cam_capture
Environment=VISION_CAPTURE_REMOTE_ACTION=run_nozzle_cam_capture
Environment=VISION_REGISTER_CALIBRATION_METHODS=1
Environment=VISION_CAMERA_PROFILE_REQUEST_FILE=/run/vision-preview-nozzle_cam/profile_request.json
Environment=VISION_CAPTURE_DEFAULT_PROFILE=analysis
Environment=VISION_PROFILE_REMOTE_METHOD=nozzle_cam_profile
Environment=VISION_PROFILE_REMOTE_ACTION=run_nozzle_cam_profile
Environment=VISIOND_CAMERA=nozzle_cam
Environment=VISIOND_SOCKET_ENABLED=1
Environment=VISIOND_SOCKET=/run/vision-capture-nozzle_cam/visiond.sock
Environment=VISION_JOB_ROOT=/home/pi/printer_data/vision/calibration/jobs
Environment=VISION_CALIBRATION_ROOT=/home/pi/printer_data/vision/calibration
Environment=VISION_CALIBRATION_GCODE_ROOT=/home/pi/printer_data/gcodes/vision_jobs
Environment=VISION_CALIBRATION_REGISTRY=/usr/local/share/vision/vision_job_types.json
Environment=VISIOND_SOCKET_REQUEST_TIMEOUT=45
ExecStart=/usr/local/bin/vision_capture.py --daemon
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
