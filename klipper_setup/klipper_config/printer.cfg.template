# Custom thermistor calibration for the left Micro Swiss FlowTech toolhead.
# Values retained from the same calibrated Micro Swiss hotend assembly.
[thermistor microswiss_calibrated]
temperature1: 35.0
resistance1: 49410
temperature2: 96.0
resistance2: 5238
temperature3: 160.0
resistance3: 909

# Left toolhead extruder on the Nitehawk.
[extruder]
step_pin: nitehawk:gpio23
dir_pin: !nitehawk:gpio24
enable_pin: !nitehawk:gpio25
microsteps: 16
rotation_distance: 7.33
nozzle_diameter: 0.400
filament_diameter: 1.750
heater_pin: nitehawk:gpio9
sensor_type: microswiss_calibrated
sensor_pin: nitehawk:gpio29
pullup_resistor: 2200
control: pid
pid_Kp: 31.708
pid_Ki: 2.578
pid_Kd: 97.504
min_temp: 0
max_temp: 300
max_extrude_only_distance: 150.0

[tmc2209 extruder]
uart_pin: nitehawk:gpio0
tx_pin: nitehawk:gpio1
uart_address: 0
run_current: 0.6
sense_resistor: 0.100
stealthchop_threshold: 999999

# Left toolhead part cooling fan.
[fan_generic left_part_fan]
pin: nitehawk:gpio6

# Left hotend heatsink fan.
[heater_fan _left_hotend_fan]
pin: nitehawk:gpio5
heater: extruder
heater_temp: 50.0
fan_speed: 1.0
tachometer_pin: nitehawk:gpio16

# Right toolhead extruder on the second Nitehawk.
[extruder1]
step_pin: right_nitehawk:gpio23
dir_pin: !right_nitehawk:gpio24
enable_pin: !right_nitehawk:gpio25
microsteps: 16
rotation_distance: 7.33
nozzle_diameter: 0.400
filament_diameter: 1.750
heater_pin: right_nitehawk:gpio9
sensor_type: microswiss_calibrated
sensor_pin: right_nitehawk:gpio29
pullup_resistor: 2200
control: pid
pid_Kp: 31.708
pid_Ki: 2.578
pid_Kd: 97.504
min_temp: 0
max_temp: 300
max_extrude_only_distance: 150.0

[tmc2209 extruder1]
uart_pin: right_nitehawk:gpio0
tx_pin: right_nitehawk:gpio1
uart_address: 0
run_current: 0.6
sense_resistor: 0.100
stealthchop_threshold: 999999

# Right toolhead part cooling fan.
[fan_generic right_part_fan]
pin: right_nitehawk:gpio6

# Right hotend heatsink fan.
[heater_fan _right_hotend_fan]
pin: right_nitehawk:gpio5
heater: extruder1
heater_temp: 50.0
fan_speed: 1.0
tachometer_pin: right_nitehawk:gpio16

# Onboard ADXL345 accelerometers on each Nitehawk 36 toolhead board.
[adxl345 left_toolhead]
cs_pin: nitehawk:gpio27
spi_software_sclk_pin: nitehawk:gpio18
spi_software_mosi_pin: nitehawk:gpio20
spi_software_miso_pin: nitehawk:gpio19

[adxl345 right_toolhead]
cs_pin: right_nitehawk:gpio27
spi_software_sclk_pin: right_nitehawk:gpio18
spi_software_mosi_pin: right_nitehawk:gpio20
spi_software_miso_pin: right_nitehawk:gpio19

[resonance_tester]
accel_chip: adxl345 left_toolhead
probe_points:
    117.5, 117.5, 20

# X-axis Pico wiring follows:
# klipper_setup/klipper_config/wiring/pico_w_btt_tmc2226_x.yaml
#
# Primary IDEX carriage: X-left. Homes to the left-mounted endstop.
[stepper_x]
step_pin: x_pico:gpio11
dir_pin: !x_pico:gpio10
enable_pin: !x_pico:gpio12
microsteps: 16
rotation_distance: 36
endstop_pin: ^x_pico:gpio4
position_endstop: ${t0_x_endstop}
position_min: ${t0_x_endstop}
position_max: 244.000
homing_positive_dir: false
homing_speed: 25
second_homing_speed: 3
homing_retract_dist: 5

# Secondary IDEX carriage: X-right. Homes to the right-mounted endstop.
# X toolhead alignment is calibrated here, not with a T1 g-code X offset.
# Change position_endstop and position_max together; keep them equal.
# The offset line calibration labels show the endpoint value to set.
[dual_carriage]
axis: x
step_pin: x_pico:gpio7
dir_pin: !x_pico:gpio6
enable_pin: !x_pico:gpio8
microsteps: 16
rotation_distance: 36
endstop_pin: ^x_pico:gpio22
position_endstop: ${t1_x_endstop}
position_min: 0.000
position_max: ${t1_x_endstop}
homing_positive_dir: true
homing_speed: 25
second_homing_speed: 3
homing_retract_dist: 5
safe_distance: 10

[tmc2209 stepper_x]
uart_pin: x_pico:gpio9
uart_address: 0
run_current: 1.4
sense_resistor: 0.110
stealthchop_threshold: 0

[tmc2209 dual_carriage]
uart_pin: x_pico:gpio5
uart_address: 0
run_current: 1.4
sense_resistor: 0.110
stealthchop_threshold: 0

# Wiring follows
# klipper_setup/klipper_config/wiring/rp2040plus_btt_tmc5160t_plus_y.yaml:
# STEP=GPIO0, DIR=GPIO1, active-low ENABLE=GPIO2, DIAG1=GPIO3,
# physical endstop=GPIO4, PWR_OK=GPIO5, and software SPI on GPIO8-11.
[stepper_y]
step_pin: y_pico:gpio0
dir_pin: !y_pico:gpio1
enable_pin: !y_pico:gpio2
microsteps: 16
# 30T GT2 pulley at 2 mm pitch = 60 mm per motor revolution.
rotation_distance: 60
full_steps_per_rotation: 200
step_pulse_duration: 0.000005
endstop_pin: ^!y_pico:gpio4
position_endstop: ${t0_y_endstop}
position_min: ${t0_y_endstop}
position_max: 296.000
homing_positive_dir: false
homing_speed: 10
second_homing_speed: 3
homing_retract_dist: 5

[tmc5160 stepper_y]
cs_pin: y_pico:gpio9
spi_software_miso_pin: y_pico:gpio8
spi_software_mosi_pin: y_pico:gpio11
spi_software_sclk_pin: y_pico:gpio10
spi_speed: 500000
interpolate: true
run_current: 3.0
sense_resistor: 0.022
stealthchop_threshold: 0

# Reserved legacy Y TMC2226 rollback config. Keep this commented while the
# dedicated TMC5160T Plus Y driver is live.
# To switch back: restore the STEP/DIR/EN/UART/DIAG wiring tags in
# pico_w_btt_tmc2226_y_z.yaml, comment the TMC5160 [stepper_y] above, then
# uncomment this block.
#
# [stepper_y]
# step_pin: gpio11
# dir_pin: !gpio10
# enable_pin: !gpio12
# microsteps: 16
# rotation_distance: 60
# endstop_pin: ^!gpio4
# position_endstop: ${t0_y_endstop}
# position_min: ${t0_y_endstop}
# position_max: 296.000
# homing_positive_dir: false
# homing_speed: 10
# second_homing_speed: 3
# homing_retract_dist: 5
#
# BTT TMC2226 V1.0 uses the tmc2209 driver in Klipper.
# [tmc2209 stepper_y]
# uart_pin: gpio9
# uart_address: 0
# run_current: 2.0
# sense_resistor: 0.110
# stealthchop_threshold: 0
# driver_SGTHRS: 0
#
# Y TMC2226 DIAG was wired to GPIO3 through a 1.2k series resistor for
# diagnostics only. Normal Y homing remains on the physical endstop.
#
# [gcode_macro _Y_TMC_STALLGUARD_STATE]
# description: Internal state for the Y TMC2226 StallGuard diagnostic mode.
# variable_armed: 0
# variable_threshold: 0
# gcode:
#     {% set state = printer["gcode_macro _Y_TMC_STALLGUARD_STATE"] %}
#     RESPOND TYPE=echo MSG="Y TMC StallGuard state: armed={state.armed|int}, threshold={state.threshold|int}."
#
# [gcode_button y_tmc_diag]
# pin: ^gpio3
# press_gcode:
#     {% set state = printer["gcode_macro _Y_TMC_STALLGUARD_STATE"] %}
#     {% set armed = state.armed|int %}
#     {% set print_state = printer.print_stats.state|string %}
#     RESPOND TYPE=echo MSG="Y TMC2226 DIAG asserted; armed={armed}, print_state={print_state}. Run Y_TMC_STATUS and inspect Y position before continuing."
#     {% if armed and print_state == "printing" %}
#         RESPOND TYPE=error MSG="Y TMC2226 DIAG asserted during armed print; pausing."
#         PAUSE
#     {% endif %}
#
# [gcode_macro Y_TMC_STATUS]
# description: Report the Y TMC2226 DIAG input and key driver registers.
# gcode:
#     QUERY_BUTTON BUTTON=y_tmc_diag
#     DUMP_TMC STEPPER=stepper_y REGISTER=IOIN
#     DUMP_TMC STEPPER=stepper_y REGISTER=DRV_STATUS
#     DUMP_TMC STEPPER=stepper_y REGISTER=SG_RESULT
#     DUMP_TMC STEPPER=stepper_y REGISTER=SGTHRS
#     Y_TMC_THERMAL_STATUS
#
# [gcode_macro Y_TMC_THERMAL_STATUS]
# description: Report Y TMC2226 thermal comparator bucket and raw DRV_STATUS.
# gcode:
#     {% set drv = printer["tmc2209 stepper_y"].drv_status %}
#     {% set t120 = 1 if drv and "t120" in drv else 0 %}
#     {% set t143 = 1 if drv and "t143" in drv else 0 %}
#     {% set t150 = 1 if drv and "t150" in drv else 0 %}
#     {% set t157 = 1 if drv and "t157" in drv else 0 %}
#     {% set otpw = 1 if drv and "otpw" in drv else 0 %}
#     {% set ot = 1 if drv and "ot" in drv else 0 %}
#     {% set cs_actual = drv["cs_actual"] if drv and "cs_actual" in drv else 0 %}
#     {% if t157 %}
#         {% set temp_bucket = ">=157C" %}
#     {% elif t150 %}
#         {% set temp_bucket = "about 150-156C" %}
#     {% elif t143 %}
#         {% set temp_bucket = "about 143-149C" %}
#     {% elif t120 %}
#         {% set temp_bucket = "about 120-142C" %}
#     {% else %}
#         {% set temp_bucket = "<120C typical junction comparator" %}
#     {% endif %}
#     RESPOND TYPE=echo MSG="Y TMC2226 thermal estimate: {temp_bucket}; bits t120={t120}, t143={t143}, t150={t150}, t157={t157}, otpw={otpw}, ot={ot}, cs_actual={cs_actual}. This is a comparator bucket, not an exact temperature."
#     DUMP_TMC STEPPER=stepper_y REGISTER=DRV_STATUS
#
# [gcode_macro Y_TMC_STALLGUARD_ARM]
# description: Arm Y TMC2226 StallGuard4 diagnostic mode with THRESHOLD=<0..255>.
# gcode:
#     {% set threshold = params.THRESHOLD|default(4)|int %}
#     {% if threshold < 0 or threshold > 255 %}
#         {action_raise_error("Y_TMC_STALLGUARD_ARM THRESHOLD must be between 0 and 255.")}
#     {% endif %}
#     M400
#     SET_TMC_FIELD STEPPER=stepper_y FIELD=SGTHRS VALUE={threshold}
#     SET_TMC_FIELD STEPPER=stepper_y FIELD=TPWMTHRS VALUE=0
#     SET_TMC_FIELD STEPPER=stepper_y FIELD=en_spreadcycle VALUE=0
#     SET_TMC_FIELD STEPPER=stepper_y FIELD=TCOOLTHRS VALUE=1048575
#     SET_TMC_FIELD STEPPER=stepper_y FIELD=SEMIN VALUE=0
#     SET_GCODE_VARIABLE MACRO=_Y_TMC_STALLGUARD_STATE VARIABLE=armed VALUE=1
#     SET_GCODE_VARIABLE MACRO=_Y_TMC_STALLGUARD_STATE VARIABLE=threshold VALUE={threshold}
#     RESPOND TYPE=echo MSG="Y TMC2226 StallGuard armed: SGTHRS={threshold}, DIAG asserts when SG_RESULT <= {threshold * 2}; TPWMTHRS=0, en_spreadcycle=0, TCOOLTHRS=1048575, SEMIN=0."
#     DUMP_TMC STEPPER=stepper_y REGISTER=GCONF
#     DUMP_TMC STEPPER=stepper_y REGISTER=TCOOLTHRS
#     DUMP_TMC STEPPER=stepper_y REGISTER=TPWMTHRS
#     DUMP_TMC STEPPER=stepper_y REGISTER=SGTHRS
#
# [gcode_macro Y_TMC_STALLGUARD_DISARM]
# description: Restore Y TMC2226 configured register state after StallGuard diagnostics.
# gcode:
#     M400
#     SET_TMC_FIELD STEPPER=stepper_y FIELD=SGTHRS VALUE=0
#     SET_TMC_FIELD STEPPER=stepper_y FIELD=TPWMTHRS VALUE=1048575
#     SET_TMC_FIELD STEPPER=stepper_y FIELD=en_spreadcycle VALUE=0
#     SET_TMC_FIELD STEPPER=stepper_y FIELD=TCOOLTHRS VALUE=0
#     SET_TMC_FIELD STEPPER=stepper_y FIELD=SEMIN VALUE=0
#     SET_GCODE_VARIABLE MACRO=_Y_TMC_STALLGUARD_STATE VARIABLE=armed VALUE=0
#     SET_GCODE_VARIABLE MACRO=_Y_TMC_STALLGUARD_STATE VARIABLE=threshold VALUE=0
#     INIT_TMC STEPPER=stepper_y
#     RESPOND TYPE=echo MSG="Y TMC2226 StallGuard disarmed; restored SGTHRS=0, TPWMTHRS=1048575, en_spreadcycle=0, TCOOLTHRS=0, SEMIN=0."
#     Y_TMC_STATUS
#
# [gcode_macro Y_TMC_DIAG_MOVE_TEST]
# description: Home Y, run a normal Y move, and optionally run the aggressive DIAG test with AGGRESSIVE=1.
# gcode:
#     {% set aggressive = params.AGGRESSIVE|default(0)|int %}
#     {% set old_velocity = printer.toolhead.max_velocity|float %}
#     {% set old_accel = printer.toolhead.max_accel|float %}
#     {% set old_scv = printer.toolhead.square_corner_velocity|float %}
#     RESPOND TYPE=echo MSG="Y TMC DIAG move test: homing Y, then moving Y20 gentle and Y120 normal. Aggressive Y260 leg runs only with AGGRESSIVE=1."
#     G90
#     G28 Y
#     QUERY_BUTTON BUTTON=y_tmc_diag
#     SET_VELOCITY_LIMIT VELOCITY=60 ACCEL=500 SQUARE_CORNER_VELOCITY=5
#     G1 Y20 F3600
#     M400
#     RESPOND TYPE=echo MSG="Y TMC DIAG move test: after gentle Y20."
#     Y_TMC_STATUS
#     SET_VELOCITY_LIMIT VELOCITY=100 ACCEL=1000 SQUARE_CORNER_VELOCITY=5
#     G1 Y120 F6000
#     M400
#     RESPOND TYPE=echo MSG="Y TMC DIAG move test: after normal Y120 at 100mm/s, 1000mm/s^2."
#     Y_TMC_STATUS
#     {% if aggressive == 1 %}
#         RESPOND TYPE=echo MSG="Y TMC DIAG move test: running aggressive Y260 at 500mm/s, 8000mm/s^2."
#         SET_VELOCITY_LIMIT VELOCITY=500 ACCEL=8000 SQUARE_CORNER_VELOCITY=10
#         G1 Y260 F30000
#         M400
#         RESPOND TYPE=echo MSG="Y TMC DIAG move test: after aggressive Y260 at 500mm/s, 8000mm/s^2."
#         Y_TMC_STATUS
#         RESPOND TYPE=echo MSG="Y TMC DIAG move test: re-homing Y after aggressive move."
#     {% else %}
#         RESPOND TYPE=echo MSG="Y TMC DIAG move test: aggressive leg skipped; rerun with AGGRESSIVE=1 only when intentionally testing stall behavior."
#     {% endif %}
#     SET_VELOCITY_LIMIT VELOCITY=60 ACCEL=500 SQUARE_CORNER_VELOCITY=5
#     G28 Y
#     SET_VELOCITY_LIMIT VELOCITY={old_velocity} ACCEL={old_accel} SQUARE_CORNER_VELOCITY={old_scv}
#     RESPOND TYPE=echo MSG="Y TMC DIAG move test complete; original velocity limits restored."

# Wiring follows klipper_setup/klipper_config/wiring/pico_w_btt_tmc2226_y_z.yaml,
# Driver 2:
# STEP=GPIO7, DIR=GPIO6, EN=GPIO8, UART=GPIO5, endstop=GPIO22.
[stepper_z]
step_pin: gpio7
dir_pin: gpio6
enable_pin: !gpio8
microsteps: 16
rotation_distance: 8
endstop_pin: ^!gpio22
position_endstop: ${t0_z_endstop}
position_min: -1.000
position_max: ${t0_z_endstop}
homing_positive_dir: true
homing_speed: 20
second_homing_speed: 2
homing_retract_dist: 3

[tmc2209 stepper_z]
uart_pin: gpio5
uart_address: 0
run_current: 1.2
sense_resistor: 0.110
stealthchop_threshold: 0

# Wiring follows klipper_setup/klipper_config/wiring/pico_w_btt_tmc2226_y_z.yaml,
# Driver 3:
# STEP=GPIO14, DIR=GPIO15, EN=GPIO16, UART=GPIO13, endstop=GPIO17.
[stepper_z1]
step_pin: gpio14
dir_pin: gpio15
enable_pin: !gpio16
microsteps: 16
rotation_distance: 8
endstop_pin: ^!gpio17

[tmc2209 stepper_z1]
uart_pin: gpio13
uart_address: 0
run_current: 1.2
sense_resistor: 0.110
stealthchop_threshold: 0

# Heatbed wiring follows
# klipper_setup/klipper_config/wiring/pico_w_btt_tmc2226_y_z.yaml:
# 24V MOSFET control on gpio21, boost SSR control on gpio20,
# and 100k B3950 NTC on gpio26 / ADC0.
[heater_bed]
heater_pin: gpio21
boost_pin: gpio20
primary_heater_power: 240.0
boost_heater_power: 500.0
pwm_cycle_time: 2.0
sensor_type: Generic 3950
sensor_pin: gpio26
pullup_resistor: 4700
# PID constants measured by calibrate_boosted_bed_pid.sh.
control: pid
pid_Kp: 31.396
pid_Ki: 0.337
pid_Kd: 731.124
min_temp: 0
max_temp: 130

# Normal GUI homing support for IDEX X, Y, and dual-Z.
#
# - G28 or "home all" homes Z first, then both X carriages, then Y.
# - G28 X homes X-left and X-right to their configured endstops.
# - G28 Y homes the real Y axis.
# - G28 Z homes both real Z motors against their independent endstops.
[homing_override]
axes: xyz
gcode:
    {% set home_all = params.X is not defined and params.Y is not defined and params.Z is not defined %}
    {% set home_x = home_all or params.X is defined %}
    {% set home_y = home_all or params.Y is defined %}
    {% set home_z = home_all or params.Z is defined %}

    {% if home_z %}
        G28 Z
    {% endif %}
    {% if home_x %}
        G28 X
    {% endif %}
    {% if home_y %}
        G28 Y
    {% endif %}


[gcode_macro _IDEX_TOOL_STATE]
variable_active_tool: 0
# Absolute tool coordinates are generated from calib.yaml. Klipper receives T0
# as real axis endstops and T1 Y/Z as derived g-code offsets relative to T0.
variable_t0_y_endstop: ${t0_y_endstop}
variable_t1_y_endstop: ${t1_y_endstop}
variable_t0_z_endstop: ${t0_z_endstop}
variable_t1_z_endstop: ${t1_z_endstop}
variable_t0_y_offset: ${t0_y_offset}
variable_t1_y_offset: ${t1_y_offset}
variable_t1_z_offset: ${t1_z_offset}
variable_bed_grid_zero_x: ${bed_grid_zero_x}
variable_bed_grid_zero_y: ${bed_grid_zero_y}
variable_offset_move_speed: 5.0
variable_park_move_speed: 180.0
gcode:

[gcode_macro _IDEX_CONFIG_FINGERPRINT]
description: Generated config identity used by update_menderpi.sh --check.
variable_source_sha256: "${config_fingerprint}"
gcode:
    RESPOND TYPE=echo MSG="IDEX config fingerprint: {printer['gcode_macro _IDEX_CONFIG_FINGERPRINT'].source_sha256}"

[gcode_macro _IDEX_PART_FAN_STATE]
variable_speed: 0.0
gcode:

[gcode_macro _IDEX_APPLY_PART_FAN]
description: Apply the stored slicer part cooling speed to the active IDEX tool.
gcode:
    {% set fan_state = printer["gcode_macro _IDEX_PART_FAN_STATE"] %}
    {% set tool_state = printer["gcode_macro _IDEX_TOOL_STATE"] %}
    {% set tool = params.TOOL|default(tool_state.active_tool)|int %}
    {% set speed = fan_state.speed|float %}
    {% if tool == 0 %}
        SET_FAN_SPEED FAN=left_part_fan SPEED={speed}
        SET_FAN_SPEED FAN=right_part_fan SPEED=0
    {% elif tool == 1 %}
        SET_FAN_SPEED FAN=left_part_fan SPEED=0
        SET_FAN_SPEED FAN=right_part_fan SPEED={speed}
    {% else %}
        { action_raise_error("_IDEX_APPLY_PART_FAN TOOL must be 0 or 1.") }
    {% endif %}

[gcode_macro M106]
description: Route slicer part cooling to the currently active IDEX tool.
gcode:
    {% set tool_state = printer["gcode_macro _IDEX_TOOL_STATE"] %}
    {% set requested = params.S|default(255)|float %}
    {% set clamped = 0.0 if requested < 0.0 else (255.0 if requested > 255.0 else requested) %}
    {% set speed = clamped / 255.0 %}
    SET_GCODE_VARIABLE MACRO=_IDEX_PART_FAN_STATE VARIABLE=speed VALUE={speed}
    _IDEX_APPLY_PART_FAN TOOL={tool_state.active_tool|int}

[gcode_macro M107]
description: Turn off both IDEX part cooling fans.
gcode:
    SET_GCODE_VARIABLE MACRO=_IDEX_PART_FAN_STATE VARIABLE=speed VALUE=0.0
    SET_FAN_SPEED FAN=left_part_fan SPEED=0
    SET_FAN_SPEED FAN=right_part_fan SPEED=0

[gcode_macro IDEX_SET_PART_FAN]
description: Directly test IDEX part cooling. Usage: IDEX_SET_PART_FAN TOOL=0|1|both SPEED=0.0..1.0
gcode:
    {% set tool = (params.TOOL|default(printer["gcode_macro _IDEX_TOOL_STATE"].active_tool) ~ "")|lower %}
    {% set speed = params.SPEED|default(1.0)|float %}
    {% if speed < 0.0 or speed > 1.0 %}
        { action_raise_error("IDEX_SET_PART_FAN SPEED must be between 0.0 and 1.0.") }
    {% endif %}
    {% if tool in ["0", "t0", "left"] %}
        SET_FAN_SPEED FAN=left_part_fan SPEED={speed}
        SET_FAN_SPEED FAN=right_part_fan SPEED=0
    {% elif tool in ["1", "t1", "right"] %}
        SET_FAN_SPEED FAN=left_part_fan SPEED=0
        SET_FAN_SPEED FAN=right_part_fan SPEED={speed}
    {% elif tool in ["both", "all"] %}
        SET_FAN_SPEED FAN=left_part_fan SPEED={speed}
        SET_FAN_SPEED FAN=right_part_fan SPEED={speed}
    {% else %}
        { action_raise_error("IDEX_SET_PART_FAN TOOL must be 0, 1, or both.") }
    {% endif %}
    RESPOND TYPE=echo MSG="IDEX part fan direct test: TOOL={tool}, SPEED={speed}"

[gcode_macro BED_COOLING]
description: Cool the bed by parking T0 over bed center and running both part fans.
variable_target: 40.0
variable_x_center: 122.0
variable_y_center: 145.0
variable_z_height: 5.0
variable_xy_move_speed: 60.0
variable_z_move_speed: 20.0
variable_fan_speed: 1.0
gcode:
    {% set target_temp = params.TARGET|default(target)|float %}
    {% set x = params.X|default(x_center)|float %}
    {% set y = params.Y|default(y_center)|float %}
    {% set z = params.Z|default(z_height)|float %}
    {% set xy_feed = xy_move_speed|float * 60.0 %}
    {% set z_feed = z_move_speed|float * 60.0 %}
    {% set homed = printer.toolhead.homed_axes %}
    SET_HEATER_TEMPERATURE HEATER=heater_bed TARGET=0
    {% if "x" not in homed or "y" not in homed or "z" not in homed %}
        G28
    {% endif %}
    SAVE_GCODE_STATE NAME=BED_COOLING_STATE
    G90
    T0
    G1 Z{z} F{z_feed}
    G1 X{x} Y{y} F{xy_feed}
    IDEX_SET_PART_FAN TOOL=both SPEED={fan_speed}
    RESPOND TYPE=echo MSG="Bed cooling until heater_bed <= {target_temp}C at X={x}, Y={y}, Z={z}."
    TEMPERATURE_WAIT SENSOR=heater_bed MAXIMUM={target_temp}
    M107
    RESTORE_GCODE_STATE NAME=BED_COOLING_STATE
    RESPOND TYPE=echo MSG="Bed cooling complete: heater_bed <= {target_temp}C."

[gcode_macro _IDEX_APPLY_TOOL_OFFSET]
description: Apply the configured g-code offset for TOOL=0 or TOOL=1.
gcode:
    {% set state = printer["gcode_macro _IDEX_TOOL_STATE"] %}
    {% set tool = params.TOOL|default(state.active_tool)|int %}
    {% set move = params.MOVE|default(0)|int %}
    {% set speed = params.MOVE_SPEED|default(state.offset_move_speed)|float %}
    {% if tool == 0 %}
        {% set y = state.t0_y_offset|float %}
        {% set z = 0.0 %}
    {% elif tool == 1 %}
        {% set y = state.t1_y_offset|float %}
        {% set z = state.t1_z_offset|float %}
    {% else %}
        { action_raise_error("IDEX tool offset TOOL must be 0 or 1.") }
    {% endif %}
    SET_GCODE_OFFSET X=0 Y={y} Z={z} MOVE={move} MOVE_SPEED={speed}
    RESPOND TYPE=echo MSG="IDEX T{tool} offset applied: X=0 endstop-calibrated, Y={y}, Z={z}, MOVE={move}"

[gcode_macro IDEX_REPORT_TOOL_OFFSETS]
description: Report configured IDEX absolute calibration and derived offsets.
gcode:
    {% set state = printer["gcode_macro _IDEX_TOOL_STATE"] %}
    {% set left_x = printer.configfile.settings.stepper_x %}
    {% set right_x = printer.configfile.settings.dual_carriage %}
    RESPOND TYPE=echo MSG="IDEX absolute T0: X={left_x.position_endstop}, Y={state.t0_y_endstop}, Z={state.t0_z_endstop}"
    RESPOND TYPE=echo MSG="IDEX absolute T1: X={right_x.position_endstop}, Y={state.t1_y_endstop}, Z={state.t1_z_endstop}"
    RESPOND TYPE=echo MSG="IDEX derived offsets: T0 Y={state.t0_y_offset}, T1 Y={state.t1_y_offset}, T1 Z={state.t1_z_offset}"

[gcode_macro IDEX_SET_TOOL_OFFSET]
description: Temporarily set IDEX Y/Z tool offsets. Usage: IDEX_SET_TOOL_OFFSET TOOL=1 Y=0 Z=0
gcode:
    {% set state = printer["gcode_macro _IDEX_TOOL_STATE"] %}
    {% set tool = params.TOOL|default(state.active_tool)|int %}
    {% set active_tool = state.active_tool|int %}
    {% set apply = params.APPLY|default(1)|int %}
    {% set requested_move = params.MOVE|default(0)|int %}
    {% set homed = printer.toolhead.homed_axes %}
    {% set can_move = 1 if requested_move and "x" in homed and "y" in homed and "z" in homed else 0 %}
    {% if tool not in [0, 1] %}
        { action_raise_error("IDEX_SET_TOOL_OFFSET TOOL must be 0 or 1.") }
    {% endif %}
    {% if params.X is defined %}
        { action_raise_error("IDEX X is calibrated by changing [dual_carriage] position_endstop and position_max together, not with g-code X offsets.") }
    {% endif %}
    {% if params.Z is defined and tool == 0 %}
        { action_raise_error("IDEX T0 Z is calibrated mechanically and with [stepper_z] position_endstop, not with a g-code Z offset.") }
    {% endif %}
    {% if params.Y is defined %}
        SET_GCODE_VARIABLE MACRO=_IDEX_TOOL_STATE VARIABLE=t{tool}_y_offset VALUE={params.Y|float}
    {% endif %}
    {% if params.Z is defined %}
        SET_GCODE_VARIABLE MACRO=_IDEX_TOOL_STATE VARIABLE=t{tool}_z_offset VALUE={params.Z|float}
    {% endif %}
    RESPOND TYPE=echo MSG="IDEX T{tool} runtime offset updated. Put proven values in printer.cfg to persist them."
    {% if apply and tool == active_tool %}
        _IDEX_APPLY_TOOL_OFFSET TOOL={tool} MOVE={can_move}
    {% endif %}

[gcode_macro IDEX_SELECT_LEFT]
description: Park X-right, activate X-left as the primary carriage, and park X-left.
gcode:
    {% if "x" not in printer.toolhead.homed_axes %}
        { action_raise_error("Home X first with G28 X or IDEX_HOME_X.") }
    {% endif %}
    {% set park_feed = printer["gcode_macro _IDEX_TOOL_STATE"].park_move_speed|float * 60.0 %}
    {% set right_park_x = printer.configfile.settings.dual_carriage.position_max|float %}
    SAVE_GCODE_STATE NAME=IDEX_SELECT_LEFT_STATE
    G90
    SET_DUAL_CARRIAGE CARRIAGE=1 MODE=PRIMARY
    G1 X{right_park_x} F{park_feed}
    SET_DUAL_CARRIAGE CARRIAGE=0 MODE=PRIMARY
    G1 X0 F{park_feed}
    RESTORE_GCODE_STATE NAME=IDEX_SELECT_LEFT_STATE
    RESPOND TYPE=echo MSG="IDEX active carriage: X-left"
    M117 IDEX X-left active

[gcode_macro IDEX_SELECT_RIGHT]
description: Park X-left, activate X-right as the primary carriage, and park X-right.
gcode:
    {% if "x" not in printer.toolhead.homed_axes %}
        { action_raise_error("Home X first with G28 X or IDEX_HOME_X.") }
    {% endif %}
    {% set park_feed = printer["gcode_macro _IDEX_TOOL_STATE"].park_move_speed|float * 60.0 %}
    {% set left_park_x = printer.configfile.settings.stepper_x.position_min|float %}
    {% set right_park_x = printer.configfile.settings.dual_carriage.position_max|float %}
    SAVE_GCODE_STATE NAME=IDEX_SELECT_RIGHT_STATE
    G90
    SET_DUAL_CARRIAGE CARRIAGE=0 MODE=PRIMARY
    G1 X{left_park_x} F{park_feed}
    SET_DUAL_CARRIAGE CARRIAGE=1 MODE=PRIMARY
    G1 X{right_park_x} F{park_feed}
    RESTORE_GCODE_STATE NAME=IDEX_SELECT_RIGHT_STATE
    RESPOND TYPE=echo MSG="IDEX active carriage: X-right"
    M117 IDEX X-right active

[gcode_macro T0]
description: Select the left IDEX toolhead and left extruder.
gcode:
    {% set state = printer["gcode_macro _IDEX_TOOL_STATE"] %}
    {% set homed = printer.toolhead.homed_axes %}
    {% set position = printer.toolhead.position %}
    {% set axis_min = printer.toolhead.axis_minimum %}
    {% set axis_max = printer.toolhead.axis_maximum %}
    {% set current_tool = state.active_tool|int %}
    {% if current_tool == 1 %}
        {% set current_y_offset = state.t1_y_offset|float %}
        {% set current_z_offset = state.t1_z_offset|float %}
    {% else %}
        {% set current_y_offset = state.t0_y_offset|float %}
        {% set current_z_offset = 0.0 %}
    {% endif %}
    {% set target_y_offset = state.t0_y_offset|float %}
    {% set target_z_offset = 0.0 %}
    {% set offset_target_y = position.y|float + target_y_offset - current_y_offset %}
    {% set offset_target_z = position.z|float + target_z_offset - current_z_offset %}
    {% set move_offsets = 1 if "x" in homed and "y" in homed and "z" in homed else 0 %}
    {% set can_move_offsets = 1 if move_offsets and offset_target_y >= axis_min.y|float and offset_target_y <= axis_max.y|float and offset_target_z >= axis_min.z|float and offset_target_z <= axis_max.z|float else 0 %}
    ACTIVATE_EXTRUDER EXTRUDER=extruder
    SET_GCODE_VARIABLE MACRO=_IDEX_TOOL_STATE VARIABLE=active_tool VALUE=0
    SET_GCODE_VARIABLE MACRO=IDEX_NEXT_PRINTABLE_CORNER VARIABLE=corner_index VALUE=0
    {% if "x" in homed %}
        IDEX_SELECT_LEFT
    {% else %}
        RESPOND TYPE=echo MSG="T0 selected left extruder. Home X before carriage parking."
    {% endif %}
    _IDEX_APPLY_TOOL_OFFSET TOOL=0 MOVE={can_move_offsets}
    {% if move_offsets and not can_move_offsets %}
        RESPOND TYPE=echo MSG="T0 offset compensation move skipped at current Y/Z edge; offset was applied without moving."
    {% endif %}
    _IDEX_APPLY_PART_FAN TOOL=0
    M117 T0 left extruder

[gcode_macro T1]
description: Select the right IDEX toolhead and right extruder.
gcode:
    {% set state = printer["gcode_macro _IDEX_TOOL_STATE"] %}
    {% set homed = printer.toolhead.homed_axes %}
    {% set position = printer.toolhead.position %}
    {% set axis_min = printer.toolhead.axis_minimum %}
    {% set axis_max = printer.toolhead.axis_maximum %}
    {% set current_tool = state.active_tool|int %}
    {% if current_tool == 1 %}
        {% set current_y_offset = state.t1_y_offset|float %}
        {% set current_z_offset = state.t1_z_offset|float %}
    {% else %}
        {% set current_y_offset = state.t0_y_offset|float %}
        {% set current_z_offset = 0.0 %}
    {% endif %}
    {% set target_y_offset = state.t1_y_offset|float %}
    {% set target_z_offset = state.t1_z_offset|float %}
    {% set offset_target_y = position.y|float + target_y_offset - current_y_offset %}
    {% set offset_target_z = position.z|float + target_z_offset - current_z_offset %}
    {% set move_offsets = 1 if "x" in homed and "y" in homed and "z" in homed else 0 %}
    {% set can_move_offsets = 1 if move_offsets and offset_target_y >= axis_min.y|float and offset_target_y <= axis_max.y|float and offset_target_z >= axis_min.z|float and offset_target_z <= axis_max.z|float else 0 %}
    ACTIVATE_EXTRUDER EXTRUDER=extruder1
    SET_GCODE_VARIABLE MACRO=_IDEX_TOOL_STATE VARIABLE=active_tool VALUE=1
    SET_GCODE_VARIABLE MACRO=IDEX_NEXT_PRINTABLE_CORNER VARIABLE=corner_index VALUE=0
    {% if "x" in homed %}
        IDEX_SELECT_RIGHT
    {% else %}
        RESPOND TYPE=echo MSG="T1 selected right extruder. Home X before carriage parking."
    {% endif %}
    _IDEX_APPLY_TOOL_OFFSET TOOL=1 MOVE={can_move_offsets}
    {% if move_offsets and not can_move_offsets %}
        RESPOND TYPE=echo MSG="T1 offset compensation move skipped at current Y/Z edge; offset was applied without moving."
    {% endif %}
    _IDEX_APPLY_PART_FAN TOOL=1
    M117 T1 right extruder

[gcode_macro TEST_X_TRAVEL]
description: Alias for TEST_X_TRAVEL_ACCEL_FOURK.
gcode:
    TEST_X_TRAVEL_ACCEL_FOURK

[gcode_macro TEST_X_TRAVEL_ACCEL_FOURK]
description: Run left and right X 100mm travel cycles at 550mm/s and 4000mm/s^2, then re-home X.
gcode:
    _TEST_X_TRAVEL_RUN ACCEL=4000 LABEL=FOURK

[gcode_macro TEST_X_TRAVEL_ACCEL_SIXK]
description: Run left and right X 100mm travel cycles at 550mm/s and 6000mm/s^2, then re-home X.
gcode:
    _TEST_X_TRAVEL_RUN ACCEL=6000 LABEL=SIXK

[gcode_macro TEST_X_TRAVEL_ACCEL_EIGHTK]
description: Run left and right X 100mm travel cycles at 550mm/s and 8000mm/s^2, then re-home X.
gcode:
    _TEST_X_TRAVEL_RUN ACCEL=8000 LABEL=EIGHTK

[gcode_macro _TEST_X_TRAVEL_RUN]
gcode:
    {% set distance = 100.0 %}
    {% set cycles = 3 %}
    {% set test_velocity = 550.0 %}
    {% set test_accel = params.ACCEL|float %}
    {% set test_label = params.LABEL|default("CUSTOM") %}
    {% set accel_label = test_accel|round(0)|int %}
    {% set test_scv = 11.0 %}
    {% set center_velocity = 60.0 %}
    {% set center_accel = 1000.0 %}
    {% set verify_velocity = 25.0 %}
    {% set verify_accel = 500.0 %}
    {% set state = printer["gcode_macro _IDEX_TOOL_STATE"] %}
    {% set park_feed = state.park_move_speed|float * 60.0 %}
    {% set left = printer.configfile.settings.stepper_x %}
    {% set right = printer.configfile.settings.dual_carriage %}
    {% set left_min = left.position_min|float %}
    {% set left_max = left.position_max|float %}
    {% set right_min = right.position_min|float %}
    {% set right_max = right.position_max|float %}
    {% set left_park_x = left_min %}
    {% set right_park_x = right_max %}
    {% set left_mid = (left_min + left_max) / 2.0 %}
    {% set right_mid = (right_min + right_max) / 2.0 %}
    {% set old_velocity = printer.toolhead.max_velocity|float %}
    {% set old_accel = printer.toolhead.max_accel|float %}
    {% set old_scv = printer.toolhead.square_corner_velocity|float %}
    {% if "x" not in printer.toolhead.homed_axes %}
        { action_raise_error("Home X first with G28 X or IDEX_HOME_X before running TEST_X_TRAVEL_ACCEL_" ~ test_label ~ ".") }
    {% elif left_mid + distance <= left_max %}
        {% set left_target = left_mid + distance %}
    {% elif left_mid - distance >= left_min %}
        {% set left_target = left_mid - distance %}
    {% else %}
        { action_raise_error("TEST_X_TRAVEL needs 100mm free left X travel.") }
    {% endif %}
    {% if right_mid + distance <= right_max %}
        {% set right_target = right_mid + distance %}
    {% elif right_mid - distance >= right_min %}
        {% set right_target = right_mid - distance %}
    {% else %}
        { action_raise_error("TEST_X_TRAVEL needs 100mm free right X travel.") }
    {% endif %}
    RESPOND TYPE=echo MSG="X travel test {test_label}: T0 center X={left_mid|round(2)} then {cycles} cycles to X={left_target|round(2)}; T1 center X={right_mid|round(2)} then {cycles} cycles to X={right_target|round(2)} at 550mm/s, accel {accel_label}mm/s^2, SCV 11."
    G90
    SET_VELOCITY_LIMIT VELOCITY={center_velocity} ACCEL={center_accel} SQUARE_CORNER_VELOCITY={old_scv}
    SET_DUAL_CARRIAGE CARRIAGE=1 MODE=PRIMARY
    G1 X{right_park_x} F{park_feed}
    SET_DUAL_CARRIAGE CARRIAGE=0 MODE=PRIMARY
    G1 X{left_mid} F{center_velocity * 60.0}
    M400
    SET_VELOCITY_LIMIT VELOCITY={test_velocity} ACCEL={test_accel} SQUARE_CORNER_VELOCITY={test_scv}
    {% for _ in range(cycles) %}
        G1 X{left_target} F{test_velocity * 60.0}
        G1 X{left_mid} F{test_velocity * 60.0}
    {% endfor %}
    M400
    SET_VELOCITY_LIMIT VELOCITY={center_velocity} ACCEL={center_accel} SQUARE_CORNER_VELOCITY={old_scv}
    SET_DUAL_CARRIAGE CARRIAGE=0 MODE=PRIMARY
    G1 X{left_park_x} F{park_feed}
    SET_DUAL_CARRIAGE CARRIAGE=1 MODE=PRIMARY
    G1 X{right_mid} F{center_velocity * 60.0}
    M400
    SET_VELOCITY_LIMIT VELOCITY={test_velocity} ACCEL={test_accel} SQUARE_CORNER_VELOCITY={test_scv}
    {% for _ in range(cycles) %}
        G1 X{right_target} F{test_velocity * 60.0}
        G1 X{right_mid} F{test_velocity * 60.0}
    {% endfor %}
    M400
    RESPOND TYPE=echo MSG="X travel test: slowly re-homing X after both toolhead travel checks. Both X endstops must stop cleanly."
    SET_VELOCITY_LIMIT VELOCITY={verify_velocity} ACCEL={verify_accel} SQUARE_CORNER_VELOCITY={old_scv}
    G28 X
    SET_VELOCITY_LIMIT VELOCITY={old_velocity} ACCEL={old_accel} SQUARE_CORNER_VELOCITY={old_scv}

[gcode_macro Y_STEP_LOSS_ASSERT_ENDSTOP]
description: Fail if the latest QUERY_ENDSTOPS did not report Y as triggered.
gcode:
    {% set profile = params.PROFILE|default("unknown") %}
    {% set velocity = params.VELOCITY|default("unknown") %}
    {% set accel = params.ACCEL|default("unknown") %}
    {% set scv = params.SCV|default("unknown") %}
    {% set cycle = params.CYCLE|default("unknown") %}
    {% set step = params.STEP|default("unknown") %}
    {% if not printer.query_endstops.last_query["stepper_y"] %}
        { action_raise_error("Y hot dry-run characterization failed: stepper_y endstop not triggered after profile=" ~ profile ~ ", velocity=" ~ velocity ~ ", accel=" ~ accel ~ ", scv=" ~ scv ~ ", cycle=" ~ cycle ~ ", step=" ~ step ~ ". Heaters may still be on; inspect, cool down if needed, then re-home Y before normal printing.") }
    {% endif %}
    RESPOND TYPE=echo MSG="Y hot dry-run endstop verified: profile={profile}, velocity={velocity}, accel={accel}, scv={scv}, cycle={cycle}, step={step}"

[gcode_macro MOTORS_OFF]
description: Disable all configured motors.
gcode:
    M84

[gcode_macro IDEX_NEXT_PRINTABLE_CORNER]
description: Move the active IDEX toolhead to the next safe printable-area corner.
variable_corner_index: 0
variable_x_min: 0.0
variable_x_max: 244.0
variable_y_min: 0.0
variable_y_max: 290.0
variable_z_travel: 10.0
variable_z_touch: 0.0
variable_xy_move_speed: 60.0
variable_z_move_speed: 20.0
gcode:
    {% set homed = printer.toolhead.homed_axes %}
    {% set tool_state = printer["gcode_macro _IDEX_TOOL_STATE"] %}
    {% set index = corner_index|int % 4 %}
    {% set next_index = (index + 1) % 4 %}
    {% set xy_feed = xy_move_speed|float * 60.0 %}
    {% set z_feed = z_move_speed|float * 60.0 %}
    {% if "x" not in homed or "y" not in homed or "z" not in homed %}
        { action_raise_error("Home X, Y, and Z before running IDEX_NEXT_PRINTABLE_CORNER.") }
    {% endif %}
    {% if index == 0 %}
        {% set corner_name = "front-left" %}
        {% set target_x = x_min|float %}
        {% set target_y = y_min|float %}
    {% elif index == 1 %}
        {% set corner_name = "front-right" %}
        {% set target_x = x_max|float %}
        {% set target_y = y_min|float %}
    {% elif index == 2 %}
        {% set corner_name = "back-right" %}
        {% set target_x = x_max|float %}
        {% set target_y = y_max|float %}
    {% else %}
        {% set corner_name = "back-left" %}
        {% set target_x = x_min|float %}
        {% set target_y = y_max|float %}
    {% endif %}
    SAVE_GCODE_STATE NAME=IDEX_NEXT_PRINTABLE_CORNER_STATE
    G90
    G1 Z{z_travel|float} F{z_feed}
    {% if tool_state.active_tool|int == 0 %}
        IDEX_SELECT_LEFT
    {% else %}
        IDEX_SELECT_RIGHT
    {% endif %}
    G1 X{target_x} Y{target_y} F{xy_feed}
    G1 Z{z_touch|float} F{z_feed}
    RESTORE_GCODE_STATE NAME=IDEX_NEXT_PRINTABLE_CORNER_STATE
    SET_GCODE_VARIABLE MACRO=IDEX_NEXT_PRINTABLE_CORNER VARIABLE=corner_index VALUE={next_index}
    RESPOND TYPE=echo MSG="IDEX printable corner {index}: {corner_name} X={target_x}, Y={target_y}, Z={z_touch|float}. Next corner index: {next_index}."

[gcode_macro _IDEX_CANCEL_PARK]
description: Safely park the active IDEX toolhead during CANCEL_PRINT.
gcode:
    {% set homed = printer.toolhead.homed_axes %}
    {% set position = printer.toolhead.position %}
    {% set axis_max = printer.toolhead.axis_maximum %}
    {% set tool_state = printer["gcode_macro _IDEX_TOOL_STATE"] %}
    {% set lift_feed = 15.0 * 60.0 %}
    {% set park_feed = tool_state.park_move_speed|float * 60.0 %}
    SAVE_GCODE_STATE NAME=IDEX_CANCEL_PARK_STATE
    G90
    {% if "z" in homed %}
        {% set z_park = [position.z|float + 5.0, axis_max.z|float]|min %}
        G1 Z{z_park} F{lift_feed}
    {% endif %}
    {% if "x" in homed %}
        {% if tool_state.active_tool|int == 0 %}
            IDEX_SELECT_LEFT
        {% else %}
            IDEX_SELECT_RIGHT
        {% endif %}
    {% endif %}
    {% if "y" in homed %}
        {% set y_park = axis_max.y|float - 5.0 %}
        G1 Y{y_park} F{park_feed}
    {% endif %}
    RESTORE_GCODE_STATE NAME=IDEX_CANCEL_PARK_STATE

[gcode_macro PAUSE]
description: Pause the active print.
rename_existing: PAUSE_BASE
gcode:
    PAUSE_BASE

[gcode_macro RESUME]
description: Resume the active print.
rename_existing: RESUME_BASE
gcode:
    RESUME_BASE {rawparams}

[gcode_macro CANCEL_PRINT]
description: Cancel the active print, park safely, and cool down.
rename_existing: CANCEL_PRINT_BASE
gcode:
    M107
    TURN_OFF_HEATERS
    CLEAR_PAUSE
    _IDEX_CANCEL_PARK
    CANCEL_PRINT_BASE

