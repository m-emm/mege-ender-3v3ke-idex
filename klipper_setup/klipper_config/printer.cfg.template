# IDEX motion config for dedicated RP2040/TMC5160T Plus Y and BTT TMC2226 Z.
#
# Generated from printer.cfg.template and calib.yaml. Edit calib.yaml for
# IDEX calibration values, then run generate_printer_cfg.py.
#
# This config exposes X-left as Klipper carriage 0 ([stepper_x]) and X-right as
# Klipper carriage 1 ([dual_carriage]), plus the proven Y and independent
# dual-Z axes. It also brings up both Nitehawk toolhead boards with the
# calibrated left/right toolheads, and enables the heatbed on the Y/Z Pico.
# Tool-switch printing is active; copy/mirror modes remain out of scope for
# this bring-up profile.

[mcu]
serial: /dev/serial/by-id/usb-Klipper_rp2040_E6633861A3673038-if00
# Alternative for temporary bring-up only:
# serial: /dev/ttyACM0

[mcu x_pico]
serial: /dev/serial/by-id/usb-Klipper_rp2040_E66368254F174333-if00

[mcu y_pico]
# Dedicated RP2040-Plus for the sequenced BTT TMC5160T Plus Y driver.
serial: /dev/serial/by-id/usb-Klipper_rp2040_DE62A87557907227-if00
restart_method: command

[mcu eddy]
# BTT Eddy Duo in USB mode. It is not a Z endstop until separately calibrated.
serial: /dev/serial/by-id/usb-Klipper_rp2040_504434040889101C-if00
restart_method: command

[mcu nitehawk]
# Left toolhead Nitehawk 36. The board presents its RP2040 through the
# Nitehawk's internal USB hub, so the by-id path is the stable identifier.
serial: /dev/serial/by-id/usb-Klipper_rp2040_30333938340637C1-if00

[mcu right_nitehawk]
# Right toolhead Nitehawk 36. This board enumerates behind the second
# Nitehawk USB hub on the printer's industrial hub.
serial: /dev/serial/by-id/usb-Klipper_rp2040_3232323236198418-if00

[temperature_sensor btt_eddy_mcu]
sensor_type: temperature_mcu
sensor_mcu: eddy
min_temp: 10
max_temp: 100

# Initialize the Eddy Duo sensor so Klipper verifies the LDC1612 identity and
# streams readings. Calibration and use as a Z endstop remain follow-up work;
# the physical Z endstops below remain authoritative.
[probe_eddy_current btt_eddy]
sensor_type: ldc1612
i2c_mcu: eddy
i2c_bus: i2c0f
x_offset: ${eddy_nozzle_to_coil_x}
y_offset: ${eddy_nozzle_to_coil_y}
descend_z: 0.5
${eddy_klipper_calibration}

[temperature_probe btt_eddy]
sensor_type: Generic 3950
sensor_pin: eddy:gpio26
horizontal_move_z: 2
calibration_temp: ${eddy_temperature_calibration_temp}

[bed_mesh]
# Central, probe-coordinate-only visualization region. Diagnostic jobs clear
# this runtime mesh and never persist a profile.
speed: 100
horizontal_move_z: 2
mesh_min: ${eddy_mesh_min_x},${eddy_mesh_min_y}
mesh_max: ${eddy_mesh_max_x},${eddy_mesh_max_y}
probe_count: 11,11
mesh_pps: 0,0
zero_reference_position: ${eddy_bed_center_x},${eddy_bed_center_y}

[printer]
kinematics: cartesian
# NEMA23 Y drive motion ceiling after July 2026 mechanical rebuild.
max_velocity: 500
max_accel: 6000
max_z_velocity: 30
max_z_accel: 300
square_corner_velocity: 5

[dotstar vision_light]
# APA102/DotStar vision light on the primary Y/Z Pico.
# The strip is powered from the 5V VBUS helper header through a level shifter.
# Eight APA102 pixels at full white may approach USB-test power limits; move
# 5V to a fused external supply if the Pico resets or the rail sags.
data_pin: gpio19
clock_pin: gpio18
chain_count: 8
initial_RED: 0.0
initial_GREEN: 0.0
initial_BLUE: 0.0

[gcode_macro VISION_LIGHT]
description: Set the APA102 vision light. Use R/G/B 0.0..1.0 and optional INDEX.
gcode:
    {% set default_channel = params.R|default(1.0)|float %}
    {% set red = default_channel %}
    {% set green = params.G|default(default_channel)|float %}
    {% set blue = params.B|default(default_channel)|float %}
    {% set index = params.INDEX|default(0)|int %}
    {% if index > 0 %}
        SET_LED LED=vision_light INDEX={index} RED={red} GREEN={green} BLUE={blue}
    {% else %}
        SET_LED LED=vision_light RED={red} GREEN={green} BLUE={blue}
    {% endif %}

[gcode_macro VISION_LIGHT_OFF]
description: Turn off the APA102 vision light.
gcode:
    SET_LED LED=vision_light RED=0 GREEN=0 BLUE=0

[gcode_macro NOZZLE_CAM_ANALYSIS_LIGHT]
description: Set tuned nozzle camera analysis illumination.
gcode:
    VISION_LIGHT_OFF
    SET_LED LED=vision_light INDEX=1 RED=0.30 GREEN=0.30 BLUE=0.30
    SET_LED LED=vision_light INDEX=2 RED=0.08 GREEN=0.08 BLUE=0.08
    SET_LED LED=vision_light INDEX=5 RED=0.08 GREEN=0.08 BLUE=0.08
    SET_LED LED=vision_light INDEX=6 RED=0.30 GREEN=0.30 BLUE=0.30
    SET_LED LED=vision_light INDEX=7 RED=0.30 GREEN=0.30 BLUE=0.30
    SET_LED LED=vision_light INDEX=8 RED=0.30 GREEN=0.30 BLUE=0.30

[gcode_macro NOZZLE_CAM_Y_FEATURE_LIGHT]
description: Set nozzle camera bed Y feature illumination.
gcode:
    VISION_LIGHT_OFF
    SET_LED LED=vision_light INDEX=2 RED=0.450 GREEN=0.450 BLUE=0.450

[delayed_gcode _NOZZLE_CAM_ANALYSIS_LIGHT_ON_STARTUP]
initial_duration: 2.0
gcode:
    NOZZLE_CAM_ANALYSIS_LIGHT

[vision]
socket_path: /run/vision-capture-nozzle_cam/visiond.sock
timeout: 45.0

# Webcam preview and high-resolution vision captures are host-side services:
# vision-framebuffer owns the camera and serves the dashboard view from RAM,
# while vision-capture persists buffered frames requested by this macro.
[gcode_macro VISION_CAPTURE]
description: Request a high-resolution webcam frame through the Pi vision-capture service.
gcode:
    {% set name = params.NAME|default("manual") %}
    {% set reason = params.REASON|default("gcode") %}
    {% set pos = printer.toolhead.position %}
    RESPOND TYPE=echo MSG="Vision capture requested: {name}"
    {action_call_remote_method("vision_capture", name=name, reason=reason, x=pos[0], y=pos[1], z=pos[2], e=pos[3])}

[gcode_macro NOZZLE_CAM_CAPTURE]
description: Request a high-resolution nozzle camera frame through the Pi vision-capture service.
gcode:
    {% set name = params.NAME|default("manual") %}
    {% set reason = params.REASON|default("gcode") %}
    {% set profile = params.PROFILE|default("analysis") %}
    {% set pos = printer.toolhead.position %}
    RESPOND TYPE=echo MSG="Nozzle camera capture requested: {name}, PROFILE={profile}"
    {action_call_remote_method("nozzle_cam_capture", name=name, reason=reason, profile=profile, x=pos[0], y=pos[1], z=pos[2], e=pos[3])}

[gcode_macro NOZZLE_CAM_PROFILE]
description: Request a reproducible nozzle camera V4L2 profile.
gcode:
    {% set profile = params.PROFILE|default("analysis") %}
    RESPOND TYPE=echo MSG="Nozzle camera profile requested: {profile}"
    {action_call_remote_method("nozzle_cam_profile", profile=profile)}

[gcode_macro NOZZLE_CAM_ANALYSIS_CAPTURE]
description: Capture a nozzle analysis frame with tuned ring-light illumination.
gcode:
    {% set name = params.NAME|default("nozzle_analysis") %}
    {% set settle_ms = params.SETTLE_MS|default(1500)|int %}
    {% set hold_ms = params.HOLD_MS|default(6000)|int %}
    {% set keep_light = params.KEEP_LIGHT|default(1)|int %}
    NOZZLE_CAM_PROFILE PROFILE=analysis
    NOZZLE_CAM_ANALYSIS_LIGHT
    G4 P{settle_ms}
    NOZZLE_CAM_CAPTURE NAME={name} REASON=nozzle_analysis PROFILE=analysis
    {% if keep_light == 0 %}
        G4 P{hold_ms}
        VISION_LIGHT_OFF
    {% endif %}

[gcode_macro IDEX_BED_FIDUCIAL_LIGHTING_CALIBRATE]
description: Select fixed low-glare lighting for the four bed fiducials.
gcode:
    {% set name = params.NAME|default("bed_fiducial_lighting") %}
    {% set print_state = printer.print_stats.state %}
    {% set homed = printer.toolhead.homed_axes %}
    {% set fingerprint = printer["gcode_macro _IDEX_CONFIG_FINGERPRINT"].source_sha256 %}
    {% if print_state not in ["standby", "complete"] %}
        { action_raise_error("IDEX_BED_FIDUCIAL_LIGHTING_CALIBRATE requires an idle printer; print_stats.state=" ~ print_state) }
    {% endif %}
    {% if "x" not in homed or "y" not in homed or "z" not in homed %}
        { action_raise_error("IDEX_BED_FIDUCIAL_LIGHTING_CALIBRATE requires X/Y/Z homed; it never homes automatically.") }
    {% endif %}
    RESPOND TYPE=echo MSG="Bed-fiducial lighting sweep queued: NAME={name}. Watch /vision/ for progress."
    {action_call_remote_method(
        "idex_bed_fiducial_lighting_calibrate",
        name=name,
        active_config_fingerprint=fingerprint
    )}

[gcode_macro IDEX_BED_FIDUCIAL_METRIC_CALIBRATE]
description: Measure the four-fiducial bed metric and printer-Y image vector.
gcode:
    {% set name = params.NAME|default("bed_fiducial_metric") %}
    {% set print_state = printer.print_stats.state %}
    {% set homed = printer.toolhead.homed_axes %}
    {% set fingerprint = printer["gcode_macro _IDEX_CONFIG_FINGERPRINT"].source_sha256 %}
    {% if print_state not in ["standby", "complete"] %}
        { action_raise_error("IDEX_BED_FIDUCIAL_METRIC_CALIBRATE requires an idle printer; print_stats.state=" ~ print_state) }
    {% endif %}
    {% if "x" not in homed or "y" not in homed or "z" not in homed %}
        { action_raise_error("IDEX_BED_FIDUCIAL_METRIC_CALIBRATE requires X/Y/Z homed; it never homes automatically.") }
    {% endif %}
    RESPOND TYPE=echo MSG="Bed-fiducial metric calibration queued: NAME={name}. Watch /vision/ for progress."
    {action_call_remote_method(
        "idex_bed_fiducial_metric_calibrate",
        name=name,
        active_config_fingerprint=fingerprint
    )}

